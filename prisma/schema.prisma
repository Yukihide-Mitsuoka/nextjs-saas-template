// Data model lands with the SaaS foundation phase (schema + RLS migration reviewed as
// one PR). This bootstrap schema only wires the toolchain (prisma generate in `make setup`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}
