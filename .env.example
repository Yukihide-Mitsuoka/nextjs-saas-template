# Environment variables — copy to .env for local development (never commit .env; GR-001).
# Every variable the application reads MUST be listed here with a dummy value and a
# one-line comment (ARC-010). Deployed environments use the platform secret manager.

# --- Runtime ---
APP_ENV=development                    # development | staging | production
LOG_LEVEL=info                         # trace | debug | info | warn | error
APP_URL=http://localhost:3000          # public base URL of this deployment

# --- Database (Cloud SQL for PostgreSQL) ---
# App connection: the RLS-ENFORCED role. Never point this at a superuser/owner role.
DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5432/saas
# Privileged connection: RLS-bypassing role used ONLY by migrations and the Clerk
# webhook sync (cross-tenant writes). Keep out of general application code.
DIRECT_DATABASE_URL=postgresql://app_admin:CHANGE_ME@localhost:5432/saas

# --- Clerk (authentication; Organizations enabled) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_EXAMPLE-000000
CLERK_SECRET_KEY=sk_test_EXAMPLE-000000
CLERK_WEBHOOK_SIGNING_SECRET=whsec_EXAMPLE-000000   # svix secret for /api/webhooks/clerk

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=sk_test_EXAMPLE-000000
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_EXAMPLE-000000

# --- Platform services (all optional; log adapters run when unset) ---
# Cloud Tasks queue full resource name + the SA whose OIDC token invokes task routes
CLOUD_TASKS_QUEUE=projects/my-proj/locations/asia-northeast1/queues/default
CLOUD_TASKS_INVOKER_SA=tasks-invoker@my-proj.iam.gserviceaccount.com
# Slack Incoming Webhook for operational notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/EXAMPLE/EXAMPLE/EXAMPLE
